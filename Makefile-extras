OPENAPI_GENERATOR_VERSION = 7.26.0

# npm package name and version of the generated SDK.
SDK_NAME ?= generated-sdk
SDK_VERSION ?= 1.0.0

x-post-deps:
	docker pull openapitools/openapi-generator-cli:v$(OPENAPI_GENERATOR_VERSION)

# Generate a typescript-fetch SDK from an OpenAPI document and pack it, e.g.
#   make -f Makefile-extras gen-sdk SPEC=path/to/openapi.yaml
#   make -f Makefile-extras gen-sdk SPEC=path/to/openapi.yaml SDK_NAME=petstore-sdk SDK_VERSION=1.2.0
# SPEC is relative to this directory (the same document you pass to
# `oag-mcp serve --spec`). The SDK directory is written to stage/generated-sdk/
# and the npm package archive to stage/$(SDK_NAME)-$(SDK_VERSION).tgz; either
# can be passed to `oag-mcp serve --sdk`. Packing installs the SDK's own
# TypeScript dev dependency, because npm pack runs its build (prepare) script.
gen-sdk:
	$(if $(SPEC),,$(error SPEC is required, e.g. make -f Makefile-extras gen-sdk SPEC=path/to/openapi.yaml))
	rm -rf stage/generated-sdk/
	mkdir -p stage/generated-sdk/
	docker \
	  run \
	  --rm \
	  --user $$(id -u):$$(id -g) \
	  -v $(CURDIR):/local \
	  openapitools/openapi-generator-cli:v$(OPENAPI_GENERATOR_VERSION) \
	  generate \
	  --input-spec /local/$(SPEC) \
	  --generator-name typescript-fetch \
	  --additional-properties npmName=$(SDK_NAME),npmVersion=$(SDK_VERSION) \
	  --output /local/stage/generated-sdk/
	cd stage/generated-sdk/ && \
	  npm install --no-audit --no-fund && \
	  npm pack --pack-destination ../

.PHONY: x-post-deps gen-sdk
