{
  "name": "oag-mcp",
  "type": "module",
  "description": "Turn an OpenAPI spec and its OpenAPI Generator (OAG) typescript-fetch SDK into a code-mode MCP server at runtime",
  "keywords": [
    "openapi",
    "openapi-generator",
    "typescript-fetch",
    "mcp",
    "model-context-protocol",
    "code-mode",
    "sdk",
    "deno",
    "sandbox"
  ],
  "version": "0.10.3-pre.0",
  "homepage": "https://github.com/oapicf/oag-mcp",
  "author": "OpenAPI Clients Factory <blah+oapicf@cliffano.com> (https://github.com/oapicf)",
  "contributors": [
    "All contributors (https://github.com/oapicf/oag-mcp/graphs/contributors)"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "oag-mcp": "bin/oag-mcp.js"
  },
  "files": [
    "assets",
    "bin",
    "conf",
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oapicf/oag-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/oapicf/oag-mcp/issues"
  },
  "directories": {
    "bin": "./bin",
    "lib": "./lib",
    "test": "./test"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "bagofcli": "4.0.0",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "jose": "6.2.15",
    "minisearch": "7.2.0",
    "openapi-sampler": "1.7.10",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "semver": "7.8.6",
    "sonic-boom": "5.0.2",
    "stemmer": "2.0.1",
    "stopword": "3.1.5",
    "tar": "7.5.22",
    "typescript": "6.0.3",
    "which": "7.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@sinonjs/referee": "11.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "@types/sinon": "22.0.2",
    "@types/stopword": "2.0.3",
    "@types/which": "3.0.4",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "esmock": "3.0.0",
    "mocha": "12.0.3",
    "mochawesome": "8.1.1",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "sinon": "22.1.0",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "license": "MIT",
  "mocha": {
    "node-option": [
      "import=tsx",
      "no-experimental-require-module"
    ],
    "extension": [
      "ts"
    ],
    "spec": [
      "test/**/*.ts"
    ],
    "ignore": [
      "test/fixtures/**",
      "test/helpers/**",
      "test/**/*.d.ts"
    ],
    "recursive": true,
    "timeout": 15000
  }
}